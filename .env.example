# Kojent Frigate Environment Configuration Example
# Rename this file to '.env' in the same directory as your compose file
# Then, customize the values below before deploying.

# --- Core Settings (Optional Overrides) ---
KOJENT_IMAGE=kojensy/kojent-frigate:latest # Docker image for your fork
CONTAINER_NAME=kojent-frigate             # Name for the running container
WEB_PORT=5000                             # Port for the Frigate Web UI
SHM_SIZE=1g                               # Shared Memory (e.g., "512m", "1g", "2g") - crucial for performance
TZ=UTC                                    # Set your local timezone (e.g., America/Denver, Europe/London)

# --- Volume Configuration (Choose ONE option below) ---

# Option 1: Use Docker Named Volumes (EASIEST DEFAULT)
# Docker manages storage location automatically (likely on OS drive).
# Config/Recordings harder to access directly from host file system.
# Leave these two lines uncommented for this option:
CONFIG_VOLUME=frigate_config
MEDIA_VOLUME=frigate_storage

# Option 2: Use Host Path Bind Mounts (ADVANCED - Full Control)
# Requires you to create directories on your host first. Easy direct file access.
# Comment out Option 1 above (#CONFIG_VOLUME=... #MEDIA_VOLUME=...)
# Then, uncomment and EDIT these two lines with your ACTUAL, full absolute paths:
#CONFIG_VOLUME=/path/on/your/host/to/frigate_config  # Example: /home/dallas/frigate/config
#MEDIA_VOLUME=/path/on/your/host/to/frigate_storage # Example: /mnt/frigate_storage/frigate_data

# --- MQTT Configuration (Required only if using docker-compose-advanced.yml) ---
MQTT_HOST=YOUR_MQTT_BROKER_IP_OR_HOSTNAME # IP or hostname (e.g., 192.168.1.10)
MQTT_PORT=1883                            # Standard MQTT port (change only if needed)
MQTT_USER=YOUR_MQTT_USERNAME              # MQTT username (leave blank or comment out if none)
MQTT_PASSWORD=YOUR_MQTT_PASSWORD          # MQTT password (leave blank or comment out if none)

